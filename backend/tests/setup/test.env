# Dummy values for the test run only. Nothing here is a real credential.
# Loaded by tests/setupEnv.js; values already present in the environment win.
# RATE_LIMIT_MAX is raised so route-matrix files can make thousands of requests;
# tests/middleware/rateLimit.test.js loads an app with a low limit to test it.
NODE_ENV=test
ACCESS_TOKEN_SECRET=staff-access-secret-staff-access-secret-0001
REFRESH_TOKEN_SCCERET=staff-refresh-secret-staff-refresh-secret-01
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PLATFORM_ACCESS_TOKEN_SECRET=platform-access-secret-platform-access-0001
PLATFORM_REFRESH_TOKEN_SECRET=platform-refresh-secret-platform-refresh-01
FRONTEND_URL=http://shop.example.test
DASHBOARD_URL=http://dashboard.example.test
API_PUBLIC_URL=https://api.example.test
RATE_LIMIT_MAX=1000000
