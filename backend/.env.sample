



# CORS: allowed browser origins (no trailing slash). Localhost is also allowed when NODE_ENV=development
FRONTEND_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173
CORS_ORIGINS=
# Global API rate limit: max requests per IP per 15 minutes
RATE_LIMIT_MAX=1000
# Reports and dashboard widgets: max requests per signed-in user per minute
REPORT_RATE_LIMIT_MAX=60
# Mail (Gmail app password). Never commit real values.
HOST_MAIL=
HOST_APP_PASSWORD=
MAIL_FROM_NAME=
# Pathao webhook secret (required; webhooks are rejected when unset)
WEBHOOK_SECRET=
# Account passwords are NOT kept here. The seeders take them as flags, so the only
# stored copy is the bcrypt hash in the database:
#   npm run superAdmin -- --email you@example.com --password '…'
#   npm run seed:platform-admin -- --email you@example.com --password '…' [--reset]
# Multi-tenancy: strict (throw without context) | shadow (unscoped without context, migration only)
TENANCY_MODE=strict
TENANCY_LOG_UNSCOPED=true
# Staff (store) auth. These two secrets ARE multi-tenant isolation: a forged
# access token names whatever tenant it likes. Each must be at least 32 characters,
# they must differ from each other and from the platform secrets below, and the
# server refuses to start in production otherwise.
#   openssl rand -base64 48
# (REFRESH_TOKEN_SCCERET keeps its historical misspelling — renaming it would
#  sign every staff member out of a running deployment.)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SCCERET=
REFRESH_TOKEN_EXPIRY=15d
# Platform (SaaS operator) auth — each secret at least 32 chars, different from staff token secrets
PLATFORM_ACCESS_TOKEN_SECRET=
PLATFORM_REFRESH_TOKEN_SECRET=
PLATFORM_ACCESS_TOKEN_EXPIRY=1h
PLATFORM_REFRESH_TOKEN_EXPIRY=7d
# Platform console origin (CORS)
PLATFORM_URL=
# Phone that receives the Platform Console sign-in code (second factor)
PLATFORM_ADMIN_PHONE=
# Per-tenant settings encryption key ring: "v1:<base64 32 bytes>" (openssl rand -base64 32). Back up separately.
SETTINGS_ENCRYPTION_KEYS=
SETTINGS_ACTIVE_KEY_VERSION=v1
# Path the API is mounted at
BASE_URL=/api/v1
# Public API origin (scheme + host, no path) used to build per-tenant webhook and
# payment callback URLs. Must be reachable from the internet, or SSLCommerz and the
# couriers cannot call back. There is no second base URL: BACKEND_URL is gone.
API_PUBLIC_URL=
# Tokens issued before multi-tenancy keep working until this ISO date (set ~15 days after migrating)
LEGACY_TOKEN_GRACE_UNTIL=
# Refresh cookie SameSite: "lax" when dashboard and API share a site (app.<domain> + api.<domain>); default none in production
AUTH_COOKIE_SAMESITE=
# Dashboard origin used in the owner's login link after provisioning
APP_URL=
# Stores whose owner sees the Platform Console in the dashboard sidebar (comma separated)
PLATFORM_WORKSPACES=
