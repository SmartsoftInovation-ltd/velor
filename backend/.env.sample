# Platform operator seeded by `npm run seed:platform-admin`, which reads these
# and takes no credential flags. This password governs every seller on the
# platform: keep this file out of git (it is), and re-seed with --reset after
# changing it or losing a machine that held it.
PLATFORM_WORKSPACES=smartsoftinovation
PLATFORM_ADMIN_EMAIL=superadmin@baig.com
PLATFORM_ADMIN_PASSWORD=SuperAdmin123
PLATFORM_ADMIN_PHONE=01747237518
PLATFORM_ADMIN_NAME=Super Admin


# Operator and staff passwords are NOT kept here — they are passed on the command
# line when the account is created, and live only as a bcrypt hash in the database:
#   node src/seeder/seedPlatformAdmin.js --email you@example.com --password '…'
#   node src/seeder/seedPlatformAdmin.js --email you@example.com --password '…' --reset
#   node src/seeder/addSuperAdminSeeder.js --email you@example.com --password '…'
# ============================================================
# URLs / CORS
# ============================================================

# Extra allowed browser origins, comma separated (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://rmg.mysmartsoftinnovation.com,
# Refresh cookie SameSite. Defaults to "none" in
# production (dashboard and API on different origins), "lax" in development.
# Set it to "lax" only when the dashboard and the API share a site
# (app.<domain> + api.<domain>) — a cross-origin dashboard would then never
# send the refresh cookie, and staff would be signed out every 15 minutes.
AUTH_COOKIE_SAMESITE=
# Global API rate limit: max requests per IP per 15 minutes
RATE_LIMIT_MAX=1000
# Reports and dashboard widgets: max requests per signed-in user per minute
REPORT_RATE_LIMIT_MAX=60
MAIL_FROM_NAME=SmartSoft Innovation
APP_TIMEZONE=Asia/Dhaka