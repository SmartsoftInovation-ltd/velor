# ============================================================
# Multi-tenancy
# ============================================================
TENANCY_MODE=strict
TENANCY_LOG_UNSCOPED=true
# DEFAULT_TENANT_SLUG removed: every request must name its store with `x-tenant`
# Tokens issued before multi-tenancy keep working until this ISO date
LEGACY_TOKEN_GRACE_UNTIL=

# ============================================================
# Platform (SaaS operator) auth — secrets >= 32 chars, must differ
# from each other and from the staff token secrets above
# ============================================================
PLATFORM_ACCESS_TOKEN_SECRET=lT9FU7Mmn4hYmFaK-9_HozqxVWKF5Gk-WKHJBOSZPNLZH07VLBNJbPc9e8aDp8IG
